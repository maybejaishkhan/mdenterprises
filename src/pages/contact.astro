---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
	title="Contact MD Enterprises | Start Your Project Consultation"
	description="Contact MD Enterprises for map design, layout planning, and engineering consultancy support."
	path="/contact"
>
	<PageHero
		title="Contact Us"
		description="Share your project goals and site details. Our team will connect with you to discuss the right planning and engineering strategy."
	/>
	<section class="py-16 sm:py-20">
		<div class="mx-auto grid max-w-container gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
			<div class="border border-brand-slate bg-brand-slate/30 p-8">
				<h2 class="text-2xl font-bold text-brand-white">Get in touch</h2>
				<p class="mt-4 text-sm leading-7 text-brand-light">
					Whether you are in early feasibility or ready for detailed planning, we can align your project with practical engineering direction.
				</p>
				<div class="mt-8 space-y-4 text-sm text-brand-light">
					<p><span class="font-semibold">Office:</span> 123 Civic Center Avenue, Pune, Maharashtra 411001</p>
					<p><span class="font-semibold">Phone:</span> +91 98765 43210</p>
					<p><span class="font-semibold">Email:</span> contact@mdenterprises.in</p>
					<p><span class="font-semibold">Hours:</span> Monday to Saturday, 9:00 AM to 6:30 PM</p>
				</div>
			</div>
			<ContactForm />
		</div>
	</section>
</Layout>
