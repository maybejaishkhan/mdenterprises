---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectsGallery from '../components/ProjectsGallery.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
	title="Projects | MD Enterprises"
	description="Review selected planning and consultancy projects completed by MD Enterprises."
	path="/projects"
>
	<PageHero
		title="Project Showcase"
		description="A curated look at residential, commercial, and mixed-use assignments delivered with precision planning and engineering foresight."
	/>
	<ProjectsGallery />
	<section class="pb-16 sm:pb-20">
		<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
			<div class="border border-brand-slate bg-brand-slate/30 p-8 shadow-lg shadow-black/20">
				<h2 class="text-2xl font-bold text-brand-white">Execution Approach</h2>
				<p class="mt-4 text-sm leading-7 text-brand-light">
					Each assignment follows a disciplined lifecycle: site diagnostics, conceptual options, stakeholder validation, compliance readiness, and implementation guidance. This helps clients move from strategy to execution with fewer surprises and stronger project control.
				</p>
			</div>
		</div>
	</section>
	<CtaBanner />
</Layout>
