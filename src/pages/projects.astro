---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectsGallery from '../components/ProjectsGallery.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Layout
	title="Projects | MD Enterprises"
	description="Review luxury developments and metropolitan projects delivered by MD Enterprises."
	path="/projects"
>
	<PageHero
		title="A portfolio of urban landmarks"
		accentWord="landmarks"
		description="A curated look at residential, commercial, and mixed-use assignments delivered with precision planning and architectural foresight."
		image="https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=2400&q=80"
	/>
	<ProjectsGallery />
	<section class="border-t border-brand-border bg-brand-elevated py-16">
		<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
			<SectionHeader
				label="Execution"
				title="Disciplined delivery at every stage"
				accentWord="stage"
				description="Each assignment follows a structured lifecycle: site diagnostics, conceptual options, stakeholder validation, compliance readiness, and implementation guidance."
			/>
		</div>
	</section>
	<CtaBanner />
</Layout>
