---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CompanyMetrics from '../components/CompanyMetrics.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Layout
	title="About MD Enterprises | Premium Engineering & Development"
	description="Discover MD Enterprises — a premium engineering and urban development partner focused on architectural precision and investment-grade outcomes."
	path="/about"
>
	<PageHero
		title="Defining metropolitan excellence"
		accentWord="excellence"
		description="We are a specialist firm focused on practical planning intelligence, regulatory alignment, and timeless development outcomes for premium urban projects."
		image="https://images.unsplash.com/photo-1511818966892-d3d833cb0010?auto=format&fit=crop&w=2400&q=80"
	/>
	<CompanyMetrics />
	<section class="py-16">
		<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
			<div class="grid gap-16 lg:grid-cols-12">
				<div class="lg:col-span-5">
					<SectionHeader
						label="Our Story"
						title="Built on engineering discipline"
						accentWord="discipline"
						description="MD Enterprises combines site intelligence, policy awareness, and technical precision to ensure every project begins with a viable and scalable foundation."
					/>
				</div>
				<div class="lg:col-span-7">
					<div class="card-luxury p-8 sm:p-10">
						<h3 class="font-heading text-xl font-bold text-brand-text">What We Value</h3>
						<ul class="mt-8 space-y-6">
							<li class="border-b border-brand-border pb-6 last:border-0 last:pb-0">
								<p class="font-heading text-sm font-semibold uppercase tracking-[0.1em] text-brand-gold">Accountability</p>
								<p class="mt-2 text-sm leading-relaxed text-brand-muted">Every recommendation and deliverable reflects technical integrity and client trust.</p>
							</li>
							<li class="border-b border-brand-border pb-6 last:border-0 last:pb-0">
								<p class="font-heading text-sm font-semibold uppercase tracking-[0.1em] text-brand-gold">Clarity</p>
								<p class="mt-2 text-sm leading-relaxed text-brand-muted">Transparent communication with stakeholders at every stage of development.</p>
							</li>
							<li class="border-b border-brand-border pb-6 last:border-0 last:pb-0">
								<p class="font-heading text-sm font-semibold uppercase tracking-[0.1em] text-brand-gold">Precision</p>
								<p class="mt-2 text-sm leading-relaxed text-brand-muted">Engineering rigor that supports safe, compliant, and enduring urban outcomes.</p>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
	<CtaBanner />
</Layout>
