---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
	title="Services | MD Enterprises"
	description="Explore premium map design, layout planning, and engineering consultancy services from MD Enterprises."
	path="/services"
>
	<PageHero
		title="Engineering services for modern skylines"
		accentWord="skylines"
		description="From early feasibility to design strategy, our service portfolio supports efficient, compliant, and investment-grade project development."
		image="https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=2400&q=80"
	/>
	<ServicesGrid />
	<ProcessTimeline />
	<CtaBanner />
</Layout>
