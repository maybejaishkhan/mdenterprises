---
import Button from './Button.astro';
import logo from '../assets/logo.jpg';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/services', label: 'Services' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-brand-border/80 bg-brand-bg/90 backdrop-blur-md">
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<div class="flex h-20 items-center justify-between gap-4">
			<a href="/" class="flex shrink-0 items-center gap-3">
				<img src={logo.src} alt="MD Enterprises logo" class="h-11 w-auto object-contain sm:h-12" width={logo.width} height={logo.height} />
			</a>

			<nav aria-label="Primary navigation" class="hidden lg:block">
				<ul class="flex items-center gap-1">
					{
						navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="px-4 py-2 font-sans text-xs font-medium uppercase tracking-[0.12em] text-brand-muted transition duration-500 hover:text-brand-gold-light"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="flex items-center gap-3">
				<Button href="/contact" className="hidden px-5 py-2.5 sm:inline-flex">Get a Quote</Button>
				<button
					id="menu-toggle"
					type="button"
					class="inline-flex h-11 w-11 items-center justify-center border border-brand-border text-brand-text transition duration-500 hover:border-brand-gold hover:text-brand-gold lg:hidden"
					aria-expanded="false"
					aria-controls="mobile-menu"
					aria-label="Toggle navigation menu"
				>
					<span class="text-xl leading-none">≡</span>
				</button>
			</div>
		</div>

		<nav id="mobile-menu" aria-label="Mobile navigation" class="hidden border-t border-brand-border pb-5 pt-3 lg:hidden">
			<ul class="flex flex-col">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="block border-b border-brand-border/60 px-2 py-3 font-sans text-xs font-medium uppercase tracking-[0.12em] text-brand-muted transition hover:text-brand-gold-light"
							>
								{link.label}
							</a>
						</li>
					))
				}
				<li class="mt-4 px-2">
					<Button href="/contact" className="w-full">Get a Quote</Button>
				</li>
			</ul>
		</nav>
	</div>
</header>

<div class="h-20" aria-hidden="true"></div>

<script>
	const toggleButton = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');

	if (toggleButton && mobileMenu) {
		toggleButton.addEventListener('click', () => {
			const expanded = toggleButton.getAttribute('aria-expanded') === 'true';
			toggleButton.setAttribute('aria-expanded', expanded ? 'false' : 'true');
			mobileMenu.classList.toggle('hidden');
		});
	}
</script>
