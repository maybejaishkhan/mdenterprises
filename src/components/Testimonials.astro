---
import SectionHeader from './SectionHeader.astro';

const testimonials = [
	{
		quote:
			'MD Enterprises delivered a planning framework that elevated our project positioning and accelerated authority approvals with remarkable clarity.',
		name: 'Rohit Mehta',
		role: 'Director, Skyline Habitat',
	},
	{
		quote:
			'Their consultancy approach is measured, technical, and investment-minded. Every recommendation reflected long-term asset performance.',
		name: 'Neha Kulkarni',
		role: 'Project Lead, Civic Growth Council',
	},
	{
		quote:
			'From initial mapping to execution advisory, the team maintained architectural discipline and corporate-level communication throughout.',
		name: 'Vikram Desai',
		role: 'Managing Partner, Axis Infra Developers',
	},
];
---

<section class="border-t border-brand-border bg-brand-elevated py-16">
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<SectionHeader
			label="Client Perspectives"
			title="Trusted by visionary developers"
			accentWord="visionary"
			description="Partnerships built on technical rigor, regulatory confidence, and premium delivery standards."
		/>

		<div class="mt-16 grid gap-6 lg:grid-cols-3">
			{
				testimonials.map((item) => (
					<figure class="reveal card-luxury flex flex-col justify-between p-8">
						<blockquote class="font-accent text-2xl leading-snug text-brand-gold-light">"{item.quote}"</blockquote>
						<figcaption class="mt-10 border-t border-brand-border pt-6">
							<p class="font-heading text-sm font-semibold uppercase tracking-[0.1em] text-brand-text">{item.name}</p>
							<p class="mt-2 text-xs uppercase tracking-[0.14em] text-brand-muted">{item.role}</p>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
