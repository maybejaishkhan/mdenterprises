---
const metrics = [
	{ value: '14+', label: 'Years of Excellence' },
	{ value: '220+', label: 'Developments Delivered' },
	{ value: '35M+', label: 'Sq. Ft. Planned' },
	{ value: '98%', label: 'Client Retention' },
];
---

<section class="border-y border-brand-border bg-brand-elevated py-16">
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			{
				metrics.map((metric, index) => (
					<article class={`reveal text-center lg:text-left ${index > 0 ? 'lg:border-l lg:border-brand-border lg:pl-10' : ''}`}>
						<p class="font-heading text-5xl font-bold tracking-cinematic text-brand-text sm:text-6xl">{metric.value}</p>
						<p class="mt-3 text-xs uppercase tracking-[0.16em] text-brand-muted">{metric.label}</p>
					</article>
				))
			}
		</div>
		</div>
</section>
