---
import Button from './Button.astro';
import LuxuryAccent from './LuxuryAccent.astro';
---

<section class="relative min-h-[92vh] overflow-hidden">
	<img
		src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2400&q=80"
		alt="Luxury metropolitan skyline at dusk"
		class="absolute inset-0 h-full w-full object-cover"
		loading="eager"
	/>
	<div class="cinematic-overlay absolute inset-0"></div>
	<div class="absolute inset-0 bg-gradient-to-r from-brand-bg via-brand-bg/80 to-transparent"></div>

	<div class="relative mx-auto flex min-h-[92vh] max-w-container flex-col justify-end px-4 pb-20 pt-32 sm:px-6 lg:px-8 lg:pb-28">
		<div class="reveal max-w-4xl">
			<p class="text-xs font-medium uppercase tracking-[0.22em] text-brand-gold">Metropolitan Development Partners</p>
			<h1 class="mt-6 font-heading text-4xl font-bold leading-[0.95] tracking-cinematic text-brand-text sm:text-6xl lg:text-7xl xl:text-8xl">
				CRAFTING <LuxuryAccent>timeless</LuxuryAccent> URBAN LANDMARKS
			</h1>
			<p class="mt-8 max-w-xl text-base leading-relaxed text-brand-muted sm:text-lg">
				MD Enterprises delivers map design, layout planning, and engineering consultancy for investment-grade developments across premium urban corridors.
			</p>
			<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
				<Button href="/contact" className="w-full sm:w-auto">Request Consultation</Button>
				<Button href="/projects" variant="secondary" className="w-full sm:w-auto">View Portfolio</Button>
			</div>
		</div>
	</div>
</section>
