---
interface Props {
	href?: string;
	variant?: 'primary' | 'secondary';
	type?: 'button' | 'submit' | 'reset';
	className?: string;
}

const { href, variant = 'primary', type = 'button', className = '' } = Astro.props;

const baseClasses =
	'inline-flex items-center justify-center px-6 py-3 text-[15px] font-semibold uppercase tracking-[0.05em] transition duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold';
const variantClasses =
	variant === 'secondary'
		? 'border border-brand-slate bg-transparent text-brand-light hover:border-brand-gold hover:text-brand-gold'
		: 'bg-brand-gold text-brand-charcoal shadow-lg shadow-black/30 hover:bg-brand-deepGold hover:text-brand-white';
---

{
	href ? (
		<a href={href} class={`${baseClasses} ${variantClasses} ${className}`}>
			<slot />
		</a>
	) : (
		<button type={type} class={`${baseClasses} ${variantClasses} ${className}`}>
			<slot />
		</button>
	)
}
