---
interface Props {
	href?: string;
	variant?: 'primary' | 'secondary' | 'ghost';
	type?: 'button' | 'submit' | 'reset';
	className?: string;
}

const { href, variant = 'primary', type = 'button', className = '' } = Astro.props;

const baseClasses =
	'inline-flex items-center justify-center px-8 py-3.5 font-sans text-xs font-semibold uppercase tracking-[0.14em] transition duration-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold';

const variantClasses = {
	primary: 'btn-primary-luxury',
	secondary:
		'border border-brand-border bg-transparent text-brand-text hover:border-brand-gold hover:text-brand-gold-light',
	ghost: 'bg-transparent text-brand-muted hover:text-brand-gold-light',
}[variant];
---

{
	href ? (
		<a href={href} class={`${baseClasses} ${variantClasses} ${className}`}>
			<slot />
		</a>
	) : (
		<button type={type} class={`${baseClasses} ${variantClasses} ${className}`}>
			<slot />
		</button>
	)
}
