---
import Button from './Button.astro';
---

<section class="py-16 sm:py-20">
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<div class="border border-brand-slate bg-brand-slate px-6 py-10 text-brand-white shadow-xl shadow-black/30 sm:px-10">
			<h2 class="text-3xl font-bold">Ready to plan your next development with confidence?</h2>
			<p class="mt-4 max-w-2xl text-base text-brand-light">
				Speak with our engineering team to define the right strategy for mapping, layout feasibility, and project execution.
			</p>
			<div class="mt-8">
				<Button href="/contact">Book a Consultation</Button>
			</div>
		</div>
	</div>
</section>
